# Copy to deploy.env and fill in your values, then run ./deploy.sh
# deploy.env is gitignored so these stay out of version control.

# Name of the S3 bucket that serves the site (no s3:// prefix)
S3_BUCKET=YOUR_BUCKET_NAME

# CloudFront distribution ID in front of the bucket (starts with E...)
CLOUDFRONT_DISTRIBUTION_ID=YOUR_DISTRIBUTION_ID
